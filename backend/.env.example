# Leo backend configuration (copy to .env and fill values; never commit secrets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Groq fallback (used when Gemini fails with retryable errors: 429/timeout/5xx/overloaded)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=en-IN
# GNANI_TTS_URL=...

DATABASE_URL=
LEO_SESSION_SECRET=
LEO_WORKSPACE_ROOT=session
PORT=8000

# Fast conversational replies (lower latency). When GROQ_API_KEY is set,
# replies may prefer Groq; code generation/explanations keep Gemini primary.
LLM_FAST_REPLY_PROVIDER=groq
GROQ_FAST_MODEL=llama-3.1-8b-instant
